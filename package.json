{
  "name": "orelius",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "Writing agent for Obsidian.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "check": "node scripts/check.mjs",
    "check:release": "node scripts/check-release.mjs",
    "build:web": "node scripts/web/build.mjs",
    "check:web": "node scripts/web/check.mjs",
    "check:obsidian": "npm run build && node scripts/check-obsidian.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "1.14.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13"
  }
}
